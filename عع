// ─── Physics ─────────────────────────────────────────────────────────────────
function resolvePlayerPlat(pl,plats){
  pl.onGround=false;
  for(const p of plats){
    if(!overlap(pl.x,pl.y,pl.w,pl.h,p.x,p.y,p.width,p.height))continue;
    const oL=(pl.x+pl.w)-p.x, oR=(p.x+p.width)-pl.x;
    const oT=(pl.y+pl.h)-p.y, oB=(p.y+p.height)-pl.y;
    const mX=Math.min(oL,oR), mY=Math.min(oT,oB);
    if(mY<mX){
      if(oT<oB){pl.y=p.y-pl.h;pl.vy=0;pl.onGround=true;}
      else{pl.y=p.y+p.height;if(pl.vy<0)pl.vy=0;}
    }else{
      if(oL<oR){pl.x=p.x-pl.w;}else{pl.x=p.x+p.width;}
      pl.vx=0;
    }
  }
}
function resolveEnemyPlat(e,plats){
  e.onGround=false;
  for(const p of plats){
    if(!overlap(e.x,e.y,e.width,e.height,p.x,p.y,p.width,p.height))continue;
    const oT=(e.y+e.height)-p.y,oB=(p.y+p.height)-e.y;
    const oL=(e.x+e.width)-p.x,oR=(p.x+p.width)-e.x;
    const mX=Math.min(oL,oR),mY=Math.min(oT,oB);
    if(mY<mX){
      if(oT<oB){e.y=p.y-e.height;e.vy=0;e.onGround=true;}
      else{e.y=p.y+p.height;if(e.vy<0)e.vy=0;}
    }else{
      if(oL<oR){e.x=p.x-e.width;e.vx=Math.abs(e.vx);}
      else{e.x=p.x+p.width;e.vx=-Math.abs(e.vx);}
    }
  }
}
// ─── Game State ───────────────────────────────────────────────────────────────
let G={state:'menu',pl:null,enemies:[],coins:[],lvIdx:0,lv:null,cam:{x:0,y:0},tick:0,lcTimer:0,score:0};
function mkPlayer(lives=3,score=0,coins=0){
  return{x:40,y:500,vx:0,vy:0,w:40,h:52,hp:5,maxHp:5,lives,onGround:false,facingRight:true,atkTimer:0,invTimer:0,isAtk:false,score,coins};
}
function cloneLv(idx){
  const src=LEVELS[idx];
  return{
    lv:src,
    enemies:src.enemies.map(e=>({...e})),
    coins:src.coins.map(c=>({...c})),
  };
}
function startGame(){
  const {lv,enemies,coins}=cloneLv(0);
  G={state:'playing',pl:mkPlayer(),enemies,coins,lvIdx:0,lv,cam:{x:0,y:0},tick:0,lcTimer:0,score:0};
}
function nextLevel(){
  const ni=G.lvIdx+1;
  if(ni>=LEVELS.length){G.state='win';return;}
  const {lv,enemies,coins}=cloneLv(ni);
  const old=G.pl;
  G.pl=mkPlayer(old.lives,old.score,old.coins);
  G.enemies=enemies;G.coins=coins;G.lv=lv;G.lvIdx=ni;
  G.cam={x:0,y:0};G.state='playing';G.lcTimer=0;
}
function respawn(){
  const pl=G.pl;
  pl.x=40;pl.y=500;pl.vx=0;pl.vy=0;pl.hp=pl.maxHp;pl.invTimer=90;
}
function takeDmg(amt){
  const pl=G.pl;
  if(pl.invTimer>0)return;
  pl.hp-=amt;pl.invTimer=80;
  if(pl.hp<=0){
    pl.hp=0;pl.lives--;
    if(pl.lives<=0){G.state='gameOver';}else{respawn();}
  }
}
// ─── Input ────────────────────────────────────────────────────────────────────
const INP={left:false,right:false,jump:false,attack:false,jumpP:false,atkP:false};
function handleAction(a,down){
  if(!down){
    if(a==='left')INP.left=false;
    if(a==='right')INP.right=false;
    if(a==='jump')INP.jump=false;
    if(a==='attack')INP.attack=false;
    return;
  }
  if(G.state!=='playing'){
    if(a==='jump'){
      if(G.state==='menu')startGame();
      else if(G.state==='levelComplete')nextLevel();
      else if(G.state==='gameOver')startGame();
      else if(G.state==='win')startGame();
    }
    return;
  }
  if(a==='left')INP.left=true;
  if(a==='right')INP.right=true;
  if(a==='jump'){if(!INP.jump)INP.jumpP=true;INP.jump=true;}
  if(a==='attack'){if(!INP.attack)INP.atkP=true;INP.attack=true;}
}
document.addEventListener('keydown',e=>{
  if(e.code==='ArrowLeft'||e.code==='KeyA'){handleAction('left',true);e.preventDefault();}
  if(e.code==='ArrowRight'||e.code==='KeyD'){handleAction('right',true);e.preventDefault();}
  if(e.code==='Space'||e.code==='ArrowUp'||e.code==='KeyW'){handleAction('jump',true);e.preventDefault();}
  if(e.code==='KeyZ'||e.code==='KeyX'||e.code==='KeyJ')handleAction('attack',true);
});
document.addEventListener('keyup',e=>{
  if(e.code==='ArrowLeft'||e.code==='KeyA')handleAction('left',false);
  if(e.code==='ArrowRight'||e.code==='KeyD')handleAction('right',false);
  if(e.code==='Space'||e.code==='ArrowUp'||e.code==='KeyW')handleAction('jump',false);
  if(e.code==='KeyZ'||e.code==='KeyX'||e.code==='KeyJ')handleAction('attack',false);
});
['btnL','btnR','btnA','btnJ'].forEach(id=>{
  const el=document.getElementById(id);
  const act=id==='btnL'?'left':id==='btnR'?'right':id==='btnA'?'attack':'jump';
  el.addEventListener('touchstart',e=>{e.preventDefault();handleAction(act,true)},{passive:false});
  el.addEventListener('touchend',e=>{e.preventDefault();handleAction(act,false)},{passive:false});
  el.addEventListener('mousedown',()=>handleAction(act,true));
  el.addEventListener('mouseup',()=>handleAction(act,false));
  el.addEventListener('mouseleave',()=>handleAction(act,false));
});
// ─── Update ──────────────────────────────────────────────────────────────────
function update(){
  G.tick++;
  if(G.state!=='playing')return;
  const pl=G.pl,lv=G.lv;
  // Move
  if(INP.left){pl.vx=-MOVE_SPEED;pl.facingRight=false;}
  else if(INP.right){pl.vx=MOVE_SPEED;pl.facingRight=true;}
  else{pl.vx*=FRICTION;if(Math.abs(pl.vx)<0.1)pl.vx=0;}
  // Jump
  if((INP.jump||INP.jumpP)&&pl.onGround){pl.vy=JUMP_FORCE;pl.onGround=false;}
  INP.jumpP=false;
  // Attack
  if(INP.atkP&&pl.atkTimer<=0){pl.isAtk=true;pl.atkTimer=22;INP.atkP=false;}
  if(pl.atkTimer>0){pl.atkTimer--;pl.isAtk=pl.atkTimer>6;}else pl.isAtk=false;
  pl.vy+=GRAVITY;if(pl.vy>18)pl.vy=18;
  pl.x+=pl.vx;pl.y+=pl.vy;
  resolvePlayerPlat(pl,lv.plats);
  if(pl.x<0){pl.x=0;pl.vx=0;}
  if(pl.x+pl.w>lv.w){pl.x=lv.w-pl.w;pl.vx=0;}
  if(pl.invTimer>0)pl.invTimer--;
  // Spikes
  for(const s of lv.spikes){
    if(overlap(pl.x+4,pl.y+4,pl.w-8,pl.h-8,s.x,s.y,s.width,s.height))takeDmg(10);
  }
  // Fall
  if(pl.y>lv.h+50)takeDmg(10);
  // Enemies
  for(const e of G.enemies){
    if(e.dead)continue;
    updateEnemy(e,lv);
    const dmg=e.isBoss?2:1;
    if(pl.invTimer<=0&&overlap(pl.x+4,pl.y+4,pl.w-8,pl.h-8,e.x,e.y,e.width,e.height))takeDmg(dmg);
    if(pl.isAtk){
      const ar=e.isBoss?60:48;
      const ax=pl.facingRight?pl.x+pl.w:pl.x-ar;
      if(overlap(ax,pl.y+4,ar,pl.h-8,e.x,e.y,e.width,e.height)&&e.stunTimer<=15){
        e.hp--;e.stunTimer=20;e.vx=pl.facingRight?2:-2;pl.score+=10;
        if(e.hp<=0){e.dead=true;pl.score+=e.isBoss?500:50;}
      }
    }
  }
  // Coins
  for(const c of G.coins){
    if(!c.collected&&overlap(pl.x+4,pl.y+4,pl.w-8,pl.h-8,c.x,c.y,16,16)){
      c.collected=true;pl.coins++;pl.score+=20;
    }
  }
  // Exit
  const boss=G.enemies.find(e=>e.isBoss&&!e.dead);
  const blocked=lv.reqBoss&&boss;
  if(!blocked&&overlap(pl.x,pl.y,pl.w,pl.h,lv.exitX-22,lv.exitY-65,44,75)){
    G.lcTimer++;if(G.lcTimer>30){G.state='levelComplete';G.lcTimer=0;}
  }else if(G.lcTimer>0)G.lcTimer--;
  // Camera
  const tx=pl.x+pl.w/2-CW/2,ty=pl.y+pl.h/2-CH/2;
  G.cam.x+=(tx-G.cam.x)*0.12;G.cam.y+=(ty-G.cam.y)*0.12;
  G.cam.x=Math.max(0,Math.min(lv.w-CW,G.cam.x));
  G.cam.y=Math.max(0,Math.min(lv.h-CH,G.cam.y));
}
function updateEnemy(e,lv){
  if(e.stunTimer>0){
    e.stunTimer--;e.vx*=0.7;
    if(e.type!=='bat'&&e.type!=='ghost'){e.vy+=GRAVITY;e.y+=e.vy;resolveEnemyPlat(e,lv.plats);}
    return;
  }
  const spd=e.isBoss?2.0:e.type==='knight'?1.2:e.type==='bat'?1.8:e.type==='ghost'?1.3:1.4;
  if(e.type==='bat'||e.type==='ghost'){
    e.vx=e.facingRight?spd:-spd;
    if(e.x+e.width>=e.pr)e.facingRight=false;
    else if(e.x<=e.pl)e.facingRight=true;
    e.vy=Math.sin(G.tick/20)*1.8;
  }else{
    if(e.x+e.width>=e.pr){e.facingRight=false;e.vx=-spd;}
    else if(e.x<=e.pl){e.facingRight=true;e.vx=spd;}
    if(e.isBoss&&G.tick%200<30)e.vx*=2.5;
    e.vy+=GRAVITY;e.y+=e.vy;resolveEnemyPlat(e,lv.plats);
  }
  e.x+=e.vx;
  if(e.x<0){e.x=0;e.vx=Math.abs(e.vx);}
  if(e.x+e.width>lv.w){e.x=lv.w-e.width;e.vx=-Math.abs(e.vx);}
}
// ─── Rendering ────────────────────────────────────────────────────────────────
const canvas=document.getElementById('gc');
const ctx=canvas.getContext('2d');
ctx.imageSmoothingEnabled=false;
const PLAT_C={
  stone:{top:'#8B7355',wall:'#6B5335',line:'#4B3315'},
  wood:{top:'#C8A06A',wall:'#A0784A',line:'#80582A'},
  dark:{top:'#5A4A6A',wall:'#3A2A4A',line:'#1A0A2A'},
};
function drawBg(camX,color1,color2){
  const g=ctx.createLinearGradient(0,0,0,CH);
  g.addColorStop(0,color1);g.addColorStop(1,color2);
  ctx.fillStyle=g;ctx.fillRect(0,0,CW,CH);
  ctx.fillStyle='rgba(255,255,255,0.55)';
  for(let i=0;i<60;i++){
    const sx=(i*137)%CW,sy=(i*97)%(CH*0.65);
    ctx.fillRect(sx,sy,i%5===0?2:1,i%5===0?2:1);
  }
  const p=(camX*0.15)%CW;
  ctx.fillStyle='rgba(20,15,40,0.8)';
  for(let i=0;i<8;i++){
    const bx=((i*300-p)%(CW+100)+CW+100)%(CW+100)-50;
    const bh=80+(i*73)%120,bw=50+(i*43)%60;
    ctx.fillRect(px(bx),CH-bh,px(bw),bh);
    ctx.fillStyle='rgba(200,180,50,0.22)';
    for(let wy=10;wy<bh-10;wy+=18)for(let wx=8;wx<bw-8;wx+=16)if((i+wy+wx)%3!==0)ctx.fillRect(px(bx+wx),CH-bh+wy,8,10);
    ctx.fillStyle='rgba(20,15,40,0.8)';
  }
}
function drawPlat(x,y,w,h,type){
  const c=PLAT_C[type]||PLAT_C.stone;
  ctx.fillStyle=c.wall;ctx.fillRect(px(x),px(y),px(w),px(h));
  ctx.fillStyle=c.top;ctx.fillRect(px(x),px(y),px(w),6);
  ctx.fillStyle=c.line;
  for(let tx=0;tx<w;tx+=20)ctx.fillRect(px(x+tx),px(y+6),2,h-6);
  for(let ty=8;ty<h;ty+=12)ctx.fillRect(px(x),px(y+ty),w,1);
  ctx.fillStyle='rgba(255,255,255,0.1)';ctx.fillRect(px(x),px(y),2,h);
}
function drawSpike(x,y,w){
  const sw=16;
  for(let sx=0;sx<w;sx+=sw){
    ctx.fillStyle='#888';
    ctx.beginPath();ctx.moveTo(px(x+sx),px(y+16));ctx.lineTo(px(x+sx+sw/2),px(y));ctx.lineTo(px(x+sx+sw),px(y+16));ctx.closePath();ctx.fill();
    ctx.fillStyle='#bbb';ctx.fillRect(px(x+sx+sw/2-1),px(y),2,3);
  }
}
function drawExit(x,y,locked){
  const t=G.tick,gl=Math.sin(t*0.05)*0.3+0.7;
  const clr=locked?'#AA2200':'#3A1A5A',inner=locked?'#CC3300':'#6A3A9A';
  ctx.fillStyle=clr;ctx.fillRect(px(x-22),px(y-65),44,75);
  ctx.fillStyle=inner;ctx.fillRect(px(x-18),px(y-61),36,67);
  ctx.fillStyle=locked?\`rgba(220,80,20,\${gl*0.5})\`:\`rgba(160,80,255,\${gl*0.4})\`;
  ctx.fillRect(px(x-14),px(y-58),28,60);
  if(!locked){ctx.fillStyle=\`rgba(200,150,255,\${gl*0.7})\`;ctx.fillRect(px(x-8),px(y-44),16,32);}
  ctx.fillStyle=locked?'#FF4400':'#FFCC44';ctx.fillRect(px(x-6),px(y-72),12,9);
  if(locked){ctx.fillStyle='#FF6622';ctx.font='bold 11px monospace';ctx.textAlign='center';ctx.fillText('BOSS!',x,y-80);ctx.textAlign='left';}
}
function drawCoin(cx,cy){
  const bob=Math.sin(G.tick*0.1+cx*0.01)*3;
  const gl=Math.sin(G.tick*0.08)*0.2+0.8;
  ctx.fillStyle=\`rgba(255,220,0,\${gl*0.3})\`;ctx.fillRect(px(cx-10),px(cy-10+bob),20,20);
  ctx.fillStyle='#FFCC00';ctx.fillRect(px(cx-6),px(cy-8+bob),12,16);ctx.fillRect(px(cx-8),px(cy-4+bob),16,8);
  ctx.fillStyle='#FFE866';ctx.fillRect(px(cx-4),px(cy-6+bob),4,8);
}
function drawSprite(key,x,y,w,h,flipX){
  const img=getImg(key);
  if(!img.complete||img.naturalWidth===0)return;
  ctx.save();
  if(flipX){ctx.translate(px(x+w),px(y));ctx.scale(-1,1);ctx.drawImage(img,0,0,px(w),px(h));}
  else ctx.drawImage(img,px(x),px(y),px(w),px(h));
  ctx.restore();
}
function drawPlayer(){
  const pl=G.pl,lv=G.lv;
  if(pl.invTimer>0&&Math.floor(pl.invTimer/4)%2===0)return;
  const sk=PLAYER_SPRITES[lv.id]||'s1';
  const bob=Math.sin(G.tick*0.12)*1.5;
  if(pl.isAtk){
    ctx.save();ctx.globalAlpha=0.3;ctx.fillStyle='#CCDDFF';
    const ax=pl.facingRight?pl.x+pl.w:pl.x-50;ctx.fillRect(px(ax),px(pl.y),50,pl.h);ctx.restore();
  }
  const sh=pl.h+10,sw=(sh/1.6)|0,ox=(pl.w-sw)/2;
  drawSprite(sk,pl.x+ox,pl.y-4+bob,sw,sh,!pl.facingRight);
}
function drawEnemy(e){
  if(e.dead)return;
  const bob=Math.sin(G.tick*0.08+e.x*0.01)*2;
  ctx.save();
  if(e.stunTimer>0)ctx.globalAlpha=0.5+Math.sin(G.tick*0.6)*0.5;
  const sk=ENEMY_SPRITES[e.sk]||e.sk;
  const sw=e.width+(e.isBoss?20:8),sh=e.height+(e.isBoss?24:10),ox=(sw-e.width)/2;
  drawSprite(sk,e.x-ox,e.y-10+bob,sw,sh,!e.facingRight);
  if(e.isBoss){
    ctx.globalAlpha=(ctx.globalAlpha)*(Math.sin(G.tick*0.05)*0.2+0.3);
    ctx.strokeStyle='#FF3300';ctx.lineWidth=3;
    ctx.strokeRect(px(e.x-4),px(e.y-4+bob),e.width+8,e.height+8);
  }
  ctx.restore();
  if(e.hp<e.maxHp){
    const bw=e.isBoss?e.width+20:e.width,bx=e.isBoss?e.x-10:e.x;
    const bf=(e.hp/e.maxHp)*bw;
    ctx.fillStyle='#1A0000';ctx.fillRect(px(bx),px(e.y-10),px(bw),6);
    ctx.fillStyle=e.isBoss?'#FF2200':'#CC2222';ctx.fillRect(px(bx),px(e.y-10),px(bf),6);
    ctx.fillStyle=e.isBoss?'#FF6644':'#FF4444';ctx.fillRect(px(bx),px(e.y-10),px(bf),2);
  }
}
function drawHUD(){
  const pl=G.pl,lv=G.lv;
